      "linkedBlockIds": []
    },
    {
      "id": "b12",
      "type": "paragraph",
      "text": "이해하기 어려운 내용은 따로 정리하고 반복해서 복습하는 습관을 만드는 것이 중요합니다.",
      "assetId": null,
